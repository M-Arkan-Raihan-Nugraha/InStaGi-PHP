# Blokir akses web langsung ke folder includes/
# (berisi kredensial dan konfigurasi).
# File ini TIDAK memengaruhi require/include dari PHP — hanya akses HTTP.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
