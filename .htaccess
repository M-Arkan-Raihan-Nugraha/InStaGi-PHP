# =============================================================================
# InStaGi — .htaccess root (Apache)
# -----------------------------------------------------------------------------
# CATATAN: file ini hanya berlaku di Apache/LiteSpeed dengan AllowOverride aktif.
# Di Nginx, aturan setara harus ditulis di konfigurasi server (bukan .htaccess).
# =============================================================================

# --- 0. Redirect kanonik: paksa HTTPS + buang awalan www. -------------------
# Tujuan: apa pun yang masuk — http://, atau host berawalan www. — berakhir di
# SATU alamat resmi versi HTTPS-nya, TANPA menyebut nama domain secara tetap.
#
# PENTING: aturan di bawah sengaja TIDAK menuliskan "instagi.iceiy.com".
# Dengan begitu situs tetap benar bila domain hosting berganti (mis. pindah ke
# *.aeonfree.com) tanpa perlu mengedit berkas ini. Untuk iceiy.com hasilnya
# sama persis seperti sebelumnya.
#
# Ditaruh paling atas supaya berlaku sebelum aturan lain.
# Jalur/query dipertahankan lewat %{REQUEST_URI}, jadi
#   http://instagi.iceiy.com/result.php?id=1 -> https://instagi.iceiy.com/result.php?id=1
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase wajib: tanpa ini, substitusi relatif (mis. imt.php) bisa
    # disusun dari PATH FISIK server sehingga menghasilkan alamat rusak.
    # Situs ini berada di akar domain, jadi basis-nya "/".
    RewriteBase /

    # (a) Host berawalan www. -> buang awalan www. (berlaku untuk domain apa pun).
    #     %1 = sisa host setelah "www." ; contoh:
    #       http://www.instagi.iceiy.com/x -> https://instagi.iceiy.com/x
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # (b) Belum HTTPS -> paksa HTTPS pada host yang SAMA (domain apa pun).
    #     Dua kondisi: HTTPS mati DAN proxy tidak menyatakan https
    #     (agar tidak terjadi redirect berulang di belakang proxy/SSL terminasi).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- 0b. Alihkan nama berkas lama bmi.php -> imt.php -------------------------
# Nama lama (bmi.php) masih dipakai di bookmark/tautan lama agar tidak rusak.
# Path & query tetap dipertahankan, jadi
#   /bmi.php?id=1  ->  /imt.php?id=1
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    # Tujuan memakai %{HTTP_HOST} (domain yang sedang aktif) supaya alihan tetap
    # benar walau domain hosting berganti. Path & query tetap dipertahankan.
    RewriteRule ^bmi\.php$ https://%{HTTP_HOST}/imt.php [R=301,L,QSA]
    RewriteRule ^css/bmi\.css$ https://%{HTTP_HOST}/css/imt.css [R=301,L]
</IfModule>

# --- 0c. Halaman utama: index.php (bukan index.html) -------------------------
# index.php diperlukan agar alamat Open Graph (og:url/og:image) bisa dibuat
# DINAMIS, sehingga pratinjau tautan tetap benar bila domain hosting berganti
# (mis. dari *.iceiy.com ke *.aeonfree.com) tanpa mengedit kode.
# Bila keduanya ada, utamakan index.php agar tidak ada dua halaman utama.
DirectoryIndex index.php

# index.html lama dialihkan permanen ke halaman utama supaya tidak ada
# konten kembar (dua-duanya bisa diakses = buruk untuk SEO & tautan lama).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L]
</IfModule>

# --- 1. Blokir file sensitif -------------------------------------------------
# File konfigurasi/kredensial & dokumentasi jangan pernah disajikan sebagai teks.
<FilesMatch "\.(md|log|sql|ini|sh|bak|old|env|json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir file tersembunyi (.env, .htaccess, dst.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Blokir TOTAL folder .git (riwayat & konfigurasi repo).
# Penting: <FilesMatch "^\."> di atas TIDAK cukup — berkas di dalam .git/
# (mis. .git/config, .git/HEAD) tidak berawalan titik, sehingga tanpa aturan
# ini isinya bisa diunduh siapa pun bila folder .git ikut ter-upload.
RedirectMatch 404 (?i)/\.git(/|$)
RedirectMatch 404 (?i)/\.svn(/|$)
RedirectMatch 404 (?i)/\.hg(/|$)

# --- 2. Matikan directory listing --------------------------------------------
Options -Indexes

# --- 3. Security headers ------------------------------------------------------
<IfModule mod_headers.c>
    # Cegah halaman ini di-embed di situs lain (clickjacking).
    Header always set X-Frame-Options "SAMEORIGIN"
    # Jangan tebak MIME type (anti MIME-sniffing).
    Header always set X-Content-Type-Options "nosniff"
    # Batasi informasi referer yang dikirim ke situs lain.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Batasi fitur browser yang tidak dipakai.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --- 4. Lindungi file kredensial di dalam includes/ ---------------------------
# (includes/.htaccess sudah memblokir seluruh folder; ini lapisan tambahan.)
<IfModule mod_rewrite.c>
    RewriteRule ^includes/(db_credentials|auth_config)\.php$ - [F,L]
</IfModule>

# --- 5. PDF (DBMP) ditampilkan di peramban, bukan langsung terunduh -----------
# Tanpa ini, sebagian server mengirim PDF sebagai lampiran (attachment) sehingga
# tombol "Lihat PDF" malah mengunduh berkas. Tombol "Unduh PDF" tetap mengunduh
# karena memakai atribut download pada tautannya.
<IfModule mod_headers.c>
    <FilesMatch "\.pdf$">
        Header set Content-Disposition "inline"
    </FilesMatch>
</IfModule>

# =============================================================================
# CATATAN PENTING — blokir DNS AdGuard (ERR_SSL_PROTOCOL_ERROR)
# -----------------------------------------------------------------------------
# Gejala: situs tampak 'tidak dapat menyediakan sambungan aman'
#         (ERR_SSL_PROTOCOL_ERROR) HANYA saat perangkat memakai DNS AdGuard.
#
# Penyebab (sudah diverifikasi): AdGuard DNS memblokir domain ini dan
# mengarahkannya ke alamat 'sinkhole' (94.140.14.33) yang TIDAK melayani TLS.
# Karena itu jabat tangan SSL gagal. Ini BUKAN masalah kode, server, maupun
# sertifikat — sertifikat situs ini sah (ZeroSSL, mencakup *.iceiy.com).
#
# Bukti: resolver AdGuard tanpa filter (unfiltered.adguard-dns.com)
# mengembalikan IP asli, sedangkan resolver AdGuard biasa mengembalikan
# IP sinkhole untuk domain yang sama.
#
# SOLUSI (di luar kode, pilih salah satu):
#   a) Minta AdGuard membuka blokir (laporkan salah-blokir):
#      https://reports.adguard.com/en/website_report.html
#   b) Di perangkat terdampak, matikan 'DNS protection'/filter AdGuard,
#      ATAU ganti DNS ke 1.1.1.1 / 8.8.8.8.
#   c) Pindah ke domain yang tidak diblokir (mis. subdomain *.aeonfree.com).
# =============================================================================
